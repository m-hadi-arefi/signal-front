generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ANALYST
  ADMIN
}

enum Direction {
  LONG
  SHORT
  NEUTRAL
}

enum EntryType {
  MARKET
  LIMIT
  STOP
  FIX
}

enum SignalStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ScenarioStatus {
  ACTIVE
  RUNNING
  CANCELLED
  INVALIDATED
  HIT_TP
  HIT_SL
}

enum CommentStatus {
  ACTIVE
  DELETED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  avatar       String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  signals       Signal[]
  comments      Comment[]
  likes         Like[]
  notifications Notification[]
  bookmarks     Bookmark[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")

  @@index([email])
  @@index([username])
  @@index([role])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, signalId])
  @@index([userId])
  @@index([signalId])
}

model Signal {
  id                       String       @id @default(cuid())
  symbol                   String
  traceId                  String?      @unique
  source                   Json?
  fromService              Boolean      @default(false)
  externalId               Int?
  rawText                  String?
  aiSummary                String?
  latestPrice              Float?
  createdPrice             Float?
  active                   Boolean      @default(true)
  activeExternalScenarioId Int?
  authorId                 String
  author                   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status                   SignalStatus  @default(OPEN)
  createdAt                DateTime     @default(now())
  analyzedAt               DateTime?
  updatedAt                DateTime     @updatedAt

  scenarios Scenario[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([authorId])
  @@index([symbol])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([fromService, externalId])
}

model Scenario {
  id           String          @id @default(cuid())
  signalId     String
  signal       Signal          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  externalId   Int?
  direction    Direction
  entryPoint   Float?
  entryType    EntryType       @default(LIMIT)
  takeProfits  Json
  stopLoss     Float?
  invalidation String?
  confidence   Int?
  reasoning    String
  status       ScenarioStatus  @default(ACTIVE)
  active       Boolean         @default(true)
  expiresAt    DateTime?
  raw          String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  performance ScenarioPerformance?

  @@index([signalId])
}

model ScenarioPerformance {
  id                     String    @id @default(cuid())
  scenarioId             String    @unique
  scenario               Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  activationTime         DateTime?
  activationPrice        Float?
  signalAgeSeconds       Float?
  isProfit               Boolean   @default(false)
  isLoss                 Boolean   @default(false)
  statusPercentNow       String?
  highestPriceReached    Float?
  lowestPriceReached     Float?
  maxProfitPercent       String?
  maxDrawdownPercent     String?
  targetsHit             Json      @default("[]")
  targetsHitAt           Json      @default("[]")
  stopLossHit            Boolean   @default(false)
  stopLossHitAt          DateTime?
  targetsCompletedCount  Int       @default(0)
  totalTargetsCount      Int       @default(0)
  successProgressPercent Float?
  priceHistory           Json      @default("[]")
  eventHistory           Json      @default("[]")
  updatedAt              DateTime  @updatedAt
}

model Comment {
  id        String        @id @default(cuid())
  signalId  String
  signal    Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("Replies")
  content   String
  status    CommentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  likes Like[]

  @@index([signalId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId  String?
  signal    Signal?  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, signalId])
  @@unique([userId, commentId])
  @@index([signalId])
  @@index([commentId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}
