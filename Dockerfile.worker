FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

RUN npm install --omit=dev && npx prisma generate

COPY src ./src
COPY tsconfig.json ./
COPY tsconfig.worker.json ./

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node_modules/.bin/tsx --tsconfig tsconfig.worker.json src/workers/signal-sync.ts"]
