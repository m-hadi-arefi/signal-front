DATABASE_URL="postgresql://postgres:postgres@postgres:5432/signaldb"
REDIS_URL="redis://redis:6379"
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
EMQX_API_URL="http://emqx:18083/api/v5"
EMQX_API_KEY="your-emqx-api-key"
EMQX_API_SECRET="your-emqx-api-secret"
EMQX_WS_URL="ws://emqx:8083/mqtt"
EMQX_MQTT_USERNAME="server"
EMQX_MQTT_PASSWORD="server-mqtt-password"
NEXT_PUBLIC_EMQX_WS_URL="ws://localhost:8083/mqtt"
# Server-only MQTT client credentials — do NOT prefix with NEXT_PUBLIC
MQTT_CLIENT_USERNAME="client"
MQTT_CLIENT_PASSWORD="client-mqtt-password"
# MinIO (S3-compatible object storage for image uploads)
MINIO_ENDPOINT="http://minio:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="uploads"
# Public site URL used for SEO sitemap/robots
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAIL="admin@signal.pro"
ADMIN_PASSWORD="Admin@123456"
ADMIN_USERNAME="signal_admin"
NODE_ENV="production"

# ── Analytics ──────────────────────────────────────────────────────────
# Matomo
NEXT_PUBLIC_MATOMO_URL=https://analytics.example.com
NEXT_PUBLIC_MATOMO_SITE_ID=1

# PostHog (self-hosted or cloud)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://product.example.com
NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=false
